{
  "name": "Auto-categorize Transactions",
  "description": "When a transaction is created with category \"other\", uses AI to suggest the right category",
  "trigger": {
    "condition": "${ (.trigger.data.category == \"other\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Transaction"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_categorize_transactions",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "categorizeTransaction",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "categorizeTransaction"
  }
}
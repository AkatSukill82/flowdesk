{
  "name": "Statement",
  "type": "object",
  "properties": {
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "D\u00e9but de la p\u00e9riode du relev\u00e9"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "Fin de la p\u00e9riode du relev\u00e9"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de g\u00e9n\u00e9ration \u2014 remplie automatiquement \u00e0 la cr\u00e9ation"
    },
    "status": {
      "type": "string",
      "enum": [
        "brouillon",
        "v\u00e9rifi\u00e9",
        "envoy\u00e9"
      ],
      "default": "brouillon"
    },
    "totals_by_currency": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "description": "Totaux par devise, ex: {\"EUR\": 342.50}"
    }
  },
  "required": [
    "period_start",
    "period_end"
  ]
}